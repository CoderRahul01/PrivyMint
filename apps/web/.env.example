# PrivyMint Web Environment Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_NETWORK=preview
NEXT_PUBLIC_CONTRACT_ADDRESS=<YOUR_DEPLOYED_CONTRACT_ADDRESS>
NEXT_PUBLIC_MIDNIGHT_RPC=https://rpc.preview.midnight.network
NEXT_PUBLIC_APP_VERSION=0.1.0

# Neon Postgres connection string (get yours at https://console.neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# PostHog Analytics (get yours at https://us.posthog.com)
POSTHOG_API_KEY=phc_your_posthog_project_key_here
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
